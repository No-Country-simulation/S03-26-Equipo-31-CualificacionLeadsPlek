---
import fondoHeader from "../assets/fondo-header.png";
import cartera from "../assets/cartera.png";
import girlOne from "../assets/Frame58.png";
import girlTwo from "../assets/Frame59.png";
import hands from "../assets/Manos.png";
---

<section class="hero-mayorista-container">
  <!-- Fondo -->
  <div class="hero-mayorista-bg">
    <img src={fondoHeader.src} alt="" />
  </div>

  <div class="hero-mayorista-content">
    <!-- Contenido izquierdo -->
    <div class="hero-mayorista-text">
      <h1>
        Menos productos genéricos. 
Más marca, más uso, más impacto
      </h1>

      <p>
        Diseño sustentable, productos duraderos y personalizados. Encuentra ejemplos en nuestra guía gratuita.
      </p>

      <!-- CTA -->
      <button
        onclick="window.open('/formulario', '_blank')"
        class="hero-mayorista-btn"
      >
        Quiero recibir la guía
      </button>
    </div>

    <!-- Imagen cartera: posición absoluta, sobresale arriba y abajo del hero -->
    <div class="hero-mayorista-image">
      <img
        src={cartera.src}
        alt="Cartera Plek"
      />
    </div>
  </div>
</section>
<!-- Formas de usar estos productos -->
<section class="ProdutsUses">
  <h3>El regalo que tu empresa necesita</h3>
  <div class="type-uses">
        <div class="uses">
          <img src={girlTwo.src} alt="chica-con-billetera"  />
          <h4>El regalo que tu equipo va a usar</h4>
          <p>Productos que se usan todos los dias. Presentes en cada reunión, onboarding y contacto con tu cliente.</p>
        </div>
         <div class="uses">
          <img src={hands.src} alt="manos" />
          <h4>Hecho a tu medida, desde cero</h4>
          <p>Trabajamos codo a codo para crear una pieza única para tu empresa.</p>
        </div>
        <div class="uses">
          <img src={girlOne.src} alt="chica-con-cartera" />
          <h4>Distinción de marca</h4>
          <p>Accesorios que comunican y hacen que tu empresa sea recordada.</p>
        </div>
       
      </div>
  </section>
      </div>
  </section>
