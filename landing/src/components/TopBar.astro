---
import searchIcon from "../assets/search.png";
import logoPlek from "../assets/logoPlek.png";
import cartIcon from "../assets/cart.png";
---

<div class="w-full bg-white">
  <div class="mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 sm:gap-3 py-2 sm:py-3 px-3 sm:px-4" style="max-width: 1420.5px;">
    <!-- Buscador -->
    <div class="flex items-center border border-gray-400 px-2 sm:px-3 flex-1 sm:flex-none" style="height: 28px; width: 100%; max-width: 226px;">
      <input
        type="text"
        placeholder="Buscar"
        class="flex-1 bg-transparent text-xs sm:text-sm text-plek-gray outline-none placeholder:text-plek-gray"
      />
      <img src={searchIcon.src} alt="Buscar" class="ml-2 h-3 sm:h-4 w-3 sm:w-4" />
    </div>

    <!-- Logo -->
    <a href="/" class="relative center sm:left-auto order-first">
      <img src={logoPlek.src} alt="Plek - Origen Hecho Cartera" class="h-8 sm:h-10" />
    </a>

    <!-- Carrito y sesión -->
    <div class="flex flex-col items-center sm:items-end gap-1 sm:gap-1 flex-1 sm:flex-none">
      <div
        class="flex items-center justify-center gap-1 sm:gap-2 border border-gray-400 flex-1 sm:flex-none"
        style="height: 28px; background-color: #535353; min-width: 120px; padding: 0 8px;"
      >
        <img src={cartIcon.src} alt="Carrito" class="h-3 sm:h-4 w-3 sm:w-4" />
        <span class="font-work text-[10px] sm:text-[14px] font-normal uppercase tracking-wide text-white whitespace-nowrap"
          >Carrito (0) $0.00</span
        >
      </div>
      <div
        class="flex items-center justify-center gap-0.5 sm:gap-1 font-work text-[9px] sm:text-[12px] font-normal uppercase flex-1 sm:flex-none"
        style="height: 16px; color: #535353;"
      >
        <a href="#" class="hover:text-plek-pink">Crear una cuenta</a>
        <span class="hidden sm:inline">|</span>
        <a href="#" class="hover:text-plek-pink">Iniciar sesión</a>
      </div>
    </div>
  </div>
</div>
