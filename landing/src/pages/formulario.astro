---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import "../styles/formulario.css";

---

<Layout title="Formulario de Catálogo | Plek">
  <section class="main-section">
    <form id="guiaForm">
      <h1>Recibir guía en mi mail</h1>
      <span>Campos obligatorios *</span>
      <label for="nombre">Nombre/Empresa*</label>
      <input type="text" id="nombre" name="nombre" required placeholder="Nombre/Empresa">
      
      <label for="email">Email*</label>
      <input type="email" id="email" name="email" required pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$" placeholder="ejemplo@ejemplo.com">
      
      <label for="regalos">¿Para qué usarías estos regalos?*</label>
      <select name="usos" id="selectCatalogo" required>
        <option value="" disabled selected>Seleccionar una opción</option>
        <option value="uno">Clientes/ fidelización</option>
        <option value="dos">Equipo interno</option>
        <option value="tres">Eventos</option>
        <option value="cuatro">Aún no lo tengo definido</option>
      </select>
      
      <label for="conoces">¿De dónde nos conoces?*</label>
      <input type="text" id="conoces" name="conoces" required placeholder="Ejemplo: En Instagram">
      
      <div class="buttons">
        <input type="submit" class="submit" value="Enviar">
        <input type="reset" class="cancel" value="Cancelar">
      </div>
    </form>
  </section>

  <div id="successOverlay" class="success-overlay" style="display: none;">
    <div class="success-card-modal">
      <div class="success-content">
        <div class="success-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <h2>Te hemos enviado el catálogo a tu correo</h2>
        <p>Revisá tu bandeja (y spam por las dudas)</p>
        
        <div class="success-footer">
          <a href="./public/catalogo.pdf" download="Guia_Plek.pdf" id="downloadBtn" class="btn-primary">Descargar PDF</a>
          <a href="/" class="btn-secondary">Volver al Inicio</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('guiaForm') as HTMLFormElement;
  const successOverlay = document.getElementById('successOverlay');
  const downloadBtn = document.getElementById('downloadBtn') as HTMLAnchorElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    // 1. Mostrar la modal de éxito
    if (successOverlay) {
      successOverlay.style.display = 'flex';
      document.body.style.overflow = 'hidden'; // Bloquea el scroll del fondo
    }

    // 2. Disparar descarga automática del PDF
    if (downloadBtn) {
      setTimeout(() => {
        downloadBtn.click();
      }, 800);
    }
  });
</script>
